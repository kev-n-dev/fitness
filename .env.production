# ── Production environment — copy to .env and fill in your values ────────────
#
# This file is for a deployment behind Cloudflare (Tunnel or proxied DNS).
# See docs/CLOUDFLARE.md for the full setup guide.

# ── Your domain ───────────────────────────────────────────────────────────────
# Replace with your actual domain. Must match exactly — passkeys are bound to it.
RP_ID=fitness.yourdomain.com
ORIGIN=https://fitness.yourdomain.com
RP_NAME=YourAppName

# ── Port the nginx container listens on inside Docker ─────────────────────────
# Cloudflare Tunnel or your reverse proxy connects to this.
WEB_PORT=8080

# ── Cloudflare real-IP header ─────────────────────────────────────────────────
# Cloudflare replaces X-Forwarded-For with its own header. This passes the real
# visitor IP to the API for throttling and the activity log.
# Only set this if Cloudflare is genuinely in front — it would be forgeable otherwise.
CF_CONNECTING_IP=$http_cf_connecting_ip

# The API is reachable only through the nginx container here, which overwrites
# X-Forwarded-For with the real peer (the Cloudflare edge IP, which is correct
# because CF_CONNECTING_IP carries the visitor's real address separately).
TRUST_PROXY=1

# ── Session length ────────────────────────────────────────────────────────────
# 90 days default. Lower for a public instance, raise for private.
SESSION_DAYS=90

# ── First user becomes admin ──────────────────────────────────────────────────
# Register your own account before sharing the URL.
FIRST_USER_ADMIN=1

# ── Optional: restrict signups ────────────────────────────────────────────────
# Uncomment to require an invite code for new profiles.
# INVITE_ONLY=1

# ── Optional: remove guest mode ──────────────────────────────────────────────
# ALLOW_GUEST=0

# ── Optional: password sign-in fallback ──────────────────────────────────────
# PASSWORD_LOGIN=1

# ── Media uploads ────────────────────────────────────────────────────────────
MEDIA_QUOTA_MB=200
MEDIA_VIDEO_MAX_MB=40
MEDIA_UPLOAD_MAX=48m
